# dircolors configuration using ANSI terminal color positions (0-15).
# Adapts automatically to any active base16 theme (phd, default-dark, etc.)
# because base16-shell remaps terminal color slots 0-15.
#
# Color key (base16 convention → ANSI slot):
#   0  black   (base00 bg) |  8  brblack  (base03)
#   1  red     (base08)    |  9  brred    (base08)
#   2  green   (base0B)    | 10  brgreen  (base0B)
#   3  yellow  (base0A)    | 11  bryellow (base0A)
#   4  blue    (base0D)    | 12  brblue   (base0D)
#   5  magenta (base0E)    | 13  brmagenta(base0E)
#   6  cyan    (base0C)    | 14  brcyan   (base0C)
#   7  white   (base05 fg) | 15  brwhite  (base07)

# --- File type classes ---
NORMAL                    00            # default (white fg = slot 7)
FILE                      00            # regular file
DIR                       01;34         # directory → bold blue (slot 4)
LINK                      01;36         # symlink  → bold cyan (slot 6)
MULTIHARDLINK             01;33         # multi-hardlink → bold yellow (slot 3)
FIFO                      35            # pipe     → magenta (slot 5)
SOCK                      01;35         # socket   → bold magenta (slot 5)
DOOR                      01;35         # door     → bold magenta (slot 5)
BLK                       01;33         # block device → bold yellow (slot 3)
CHR                       01;31         # char device → bold red (slot 1)
ORPHAN                    01;31;47      # orphan symlink → bold red on white
SETUID                    37;41         # setuid   → white on red
SETGID                    30;43         # setgid   → black on yellow
CAPABILITY                01;31         # capability → bold red
STICKY                    01;96         # sticky   → bold brcyan (slot 14)
OTHER_WRITABLE            01;93         # other-writable → bold bryellow (slot 11)
STICKY_OTHER_WRITABLE     01;93         # sticky+other-writable → bold bryellow (slot 11)
EXEC                      01;32         # executable → bold green (slot 2)

